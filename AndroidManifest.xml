<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lingyue.honorbass">
    <application android:label="HonorBass" android:icon="@mipmap/ic_launcher" android:hasCode="true">
        <activity android:name=".MainActivity" android:exported="true" android:label="HonorBass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:value="HONOR Sound 尊享低音：支持的应用列表放行全部正常应用（UI显示+iAware+DSP端到端生效）。作者：铃月"/>
